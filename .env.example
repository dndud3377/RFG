DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=

# ============================================
# 인증 — request-site와 동일한 사내 ADFS SSO 계정을 쓴다
# ============================================
AUTH_MODE=sso

# ADFS(OIDC) — request-site가 등록된 것과 같은 ADFS 테넌트 값을 그대로 쓰거나,
# RFG용으로 새로 등록한 RP 값을 쓴다. (담당자에게 문의)
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_OP_AUTHORIZATION_ENDPOINT=
OIDC_OP_LOGOUT_ENDPOINT=
OIDC_CALLBACK_BASE_URL=
OIDC_CERT_FILE_NAME=company.net.cer

# id_token 검증 후 발급하는 자체 서비스 JWT — 반드시 무작위 값으로 채운다.
SERVICE_JWT_SECRET_KEY=

# ============================================
# 메일 발송 인프라 (request-site와 동일한 DXHUB 게이트웨이) — 현재는 인프라만,
# 실제로 메일을 보내는 이벤트가 생기기 전까지는 비워둬도 무방하다.
# ============================================
DXHUB_MAIL_URL=
DXHUB_API_KEY=
FRONTEND_URL=
MAIL_REDIRECT_TO=

CORS_ALLOWED_ORIGINS=
